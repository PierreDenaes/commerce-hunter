# Database
DATABASE_URL=postgresql://commercehunter:CHANGE_ME@postgres:5432/commercehunter
POSTGRES_USER=commercehunter
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=commercehunter

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_production_jwt_secret
JWT_REFRESH_SECRET=CHANGE_ME_production_jwt_refresh_secret

# INSEE SIRENE API
SIRENE_API_TOKEN=CHANGE_ME

# Google APIs
GOOGLE_PLACES_API_KEY=CHANGE_ME
PAGESPEED_API_KEY=CHANGE_ME

# Stripe (live keys)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# App
NEXT_PUBLIC_API_URL=https://commercehunter.dnada.cloud
PORT_API=3001
NODE_ENV=production
CORS_ORIGIN=https://commercehunter.dnada.cloud
LOG_LEVEL=warn

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# Frontend URL (for email links)
FRONTEND_URL=https://commercehunter.dnada.cloud
